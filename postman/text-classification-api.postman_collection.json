    {
      "name": "Classification",
      "item": [
        {
          "name": "Complaint",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response has a valid category and confidence', () => {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(['Complaint', 'Query', 'Feedback', 'Other']).to.include(body.data.category);",
                  "  pm.expect(body.data.confidence).to.be.within(0, 1);",
                  "});",
                  "pm.test('Category is Complaint (AI-dependent)', () => pm.expect(body.data.category).to.eql('Complaint'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"My order has not arrived and nobody is responding to my emails.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/classify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "classify"]
            },
            "description": "Expected category: Complaint. The AI result can vary, so the category check is informational."
          }
        },
