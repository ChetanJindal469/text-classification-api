# Application configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Gemini AI configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Overall budget per classification, including all attempts and backoff.
GEMINI_TIMEOUT_MS=30000
# Maximum duration of a single Gemini attempt. A timed-out attempt is retried
# while the overall budget has time left.
GEMINI_ATTEMPT_TIMEOUT_MS=10000
# Retries for transient errors (0-5), with exponential backoff and jitter
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_DELAY_MS=1000

# Logging configuration
LOG_LEVEL=info
